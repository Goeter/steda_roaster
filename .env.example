# Main CMS connection
CMS_API_URL=https://stedacms.autoworkspace.me
CMS_READ_TOKEN=

# Set the same new secret in the frontend hosting environment and CMS webhook.
# Never commit the real production secret to this template.
# IMPORTANT: This secret protects both /api/cms/revalidate and /api/cms/health endpoints.
# Use a strong random string (min 32 characters). Example: openssl rand -base64 32
CMS_REVALIDATE_SECRET=

# Cache and request settings
# Safety-net cache TTL (seconds). Primary updates are via admin-triggered on-demand revalidation.
# 60 = if webhook misses, content auto-refreshes within 60s max. Set higher for less DB load.
CMS_REVALIDATE_SECONDS=60
CMS_FETCH_TIMEOUT_MS=15000

# false = fallback local data is used when CMS is unavailable.
# true  = CMS is the only accepted content source; CMS errors fail the request.
CMS_STRICT_MODE=false

# Optional endpoint overrides. Keep commented when the CMS follows the default contract.
# CMS_ENDPOINT_LAYOUT=/api/layout
# CMS_ENDPOINT_HOME=/api/home
# CMS_ENDPOINT_ABOUT=/api/about
# CMS_ENDPOINT_PRODUCTS_PAGE=/api/products-page
# CMS_ENDPOINT_PRODUCT_DETAIL=/api/product-detail
# CMS_ENDPOINT_FAQS=/api/faqs
# CMS_ENDPOINT_NEWS_PAGE=/api/news-page
# CMS_ENDPOINT_NEWS_DETAIL=/api/news-detail
